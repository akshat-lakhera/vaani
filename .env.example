# Pick one STT provider. Sarvam is the default (Indic + code-mix).
STT_PROVIDER=sarvam
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# Optional extractive-answer polish. The fast path never needs this.
XAI_API_KEY=

# Hugging Face (only needed if the dataset is gated / rate-limited)
HF_TOKEN=

VAANI_DATA_DIR=data
VAANI_INDEX_NAME=shipped
VAANI_LANGUAGES=hi,mr
VAANI_HOST=0.0.0.0
VAANI_PORT=8080
